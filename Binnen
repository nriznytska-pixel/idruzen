<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Café iDruzen · Binnen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --porcelain:#F3E9D6; --surface:#FFF9EE; --delft:#5A3A22; --delft-soft:#EAD9BC;
  --amber:#D98E2B; --amber-soft:#F6E2BF; --ink:#2A1A12; --muted:#6E5A48; --sage:#3E5C48;
  --line:#DCC9A8; --danger:#A8321F; --danger-soft:#F7DDD6;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --porcelain:#1C130D; --surface:#2A1D14; --delft:#E9B86A; --delft-soft:#3A2817;
    --amber:#E9A84A; --amber-soft:#3A2817; --ink:#F3E9D6; --muted:#BFA88C; --sage:#9DBBA3;
    --line:#46321F; --danger:#FF9A85; --danger-soft:#3D1F18;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --porcelain:#1C130D; --surface:#2A1D14; --delft:#E9B86A; --delft-soft:#3A2817;
  --amber:#E9A84A; --amber-soft:#3A2817; --ink:#F3E9D6; --muted:#BFA88C; --sage:#9DBBA3;
  --line:#46321F; --danger:#FF9A85; --danger-soft:#3D1F18;
  color-scheme:dark;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;height:100%;background:var(--porcelain);color:var(--ink);
  font:400 16px/1.5 Figtree,system-ui,-apple-system,Segoe UI,sans-serif}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px}

.app{height:100%;display:grid;grid-template-rows:auto auto 1fr auto;max-width:760px;margin:0 auto}

/* header: the hub sign */
.sign{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 18px 10px}
.sign h1{margin:0;font:400 clamp(28px,6vw,40px)/1.05 "Young Serif",Georgia,serif;color:var(--delft);letter-spacing:-.01em}
.sign p{margin:4px 0 0;color:var(--muted);font-size:14px}
.help{border:1.5px solid var(--danger);background:transparent;color:var(--danger);border-radius:999px;padding:8px 14px;font-weight:600;font-size:14px;white-space:nowrap}

/* rooms as a tiled floor */
.rooms{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:6px 18px 12px}
.room{border:1.5px solid var(--line);background:var(--surface);border-radius:14px;padding:10px 8px;text-align:left;display:flex;flex-direction:column;gap:2px;min-height:64px}
.room b{font-weight:600;font-size:15px}
.room span{font-size:12.5px;color:var(--muted);line-height:1.3}
.room[aria-pressed="true"]{border-color:var(--delft);background:var(--delft-soft)}

/* the table: who is sitting with you */
.table{display:flex;align-items:center;gap:10px;padding:10px 18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface);overflow-x:auto}
.seat{display:flex;align-items:center;gap:8px;border:0;background:transparent;padding:4px 10px 4px 4px;border-radius:999px;flex:none}
.seat[aria-current="true"]{background:var(--amber-soft)}
.face{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font:400 16px "Young Serif",serif;color:#fff;flex:none}
.seat small{display:block;color:var(--muted);font-size:12px;line-height:1.1}
.seat strong{display:block;font-weight:600;font-size:14px;line-height:1.2}

/* chat */
.chat{overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
.msg{max-width:84%;padding:10px 14px;border-radius:18px;white-space:pre-wrap;overflow-wrap:anywhere}
.msg.them{background:var(--surface);border:1px solid var(--line);border-bottom-left-radius:6px;align-self:flex-start}
.msg.me{background:var(--delft);color:var(--porcelain);border-bottom-right-radius:6px;align-self:flex-end}
.who{font-size:12px;color:var(--muted);margin:0 0 2px 4px;align-self:flex-start}
.note{align-self:center;font-size:13px;color:var(--muted);text-align:center;max-width:90%}
.choice{align-self:flex-start;display:flex;flex-wrap:wrap;gap:8px;max-width:100%}
.chip{border:1.5px solid var(--delft);background:transparent;color:var(--delft);border-radius:999px;padding:7px 14px;font-weight:500;font-size:14px}
.chip.primary{background:var(--delft);color:var(--porcelain)}
.typing{align-self:flex-start;color:var(--muted);font-size:14px;padding:4px 6px}

.crisis{align-self:stretch;background:var(--danger-soft);border:1.5px solid var(--danger);border-radius:16px;padding:14px 16px}
.crisis p{margin:0 0 10px}
.crisis .calls{display:flex;flex-wrap:wrap;gap:8px}
.crisis a{display:inline-block;background:var(--danger);color:#fff;text-decoration:none;border-radius:12px;padding:10px 14px;font-weight:600}
:root[data-theme="dark"] .crisis a{color:#1A1F2E}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .crisis a{color:#1A1F2E}}

/* composer */
.composer{display:flex;gap:8px;padding:10px 14px 14px;border-top:1px solid var(--line);background:var(--porcelain)}
.composer textarea{flex:1;resize:none;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:16px;padding:10px 14px;font:inherit;min-height:46px;max-height:140px}
.composer textarea:focus{border-color:var(--delft);outline:none}
.send{border:0;background:var(--amber);color:#1A1F2E;border-radius:16px;padding:0 18px;font-weight:600}
.send:disabled{opacity:.5;cursor:default}
.tools{display:flex;justify-content:flex-end;padding:0 18px 4px}
.link{border:0;background:none;color:var(--muted);font-size:13px;text-decoration:underline;padding:4px}

dialog{border:0;border-radius:18px;padding:0;max-width:min(440px,92vw);background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(28,19,13,.6)}
.dlg{padding:20px}
.dlg h2{margin:0 0 8px;font:400 22px "Young Serif",serif;color:var(--delft)}
.dlg ul{padding-left:20px;margin:8px 0 14px}
@media (prefers-reduced-motion:no-preference){.msg{animation:in .18s ease-out}@keyframes in{from{opacity:0;transform:translateY(4px)}}}
@media (max-width:420px){.room span{display:none}.room{min-height:auto}}
</style>
</head>
<body>
<div class="app">
  <header class="sign">
    <div>
      <h1><a href="./" style="color:inherit;text-decoration:none">Café iDruzen</a></h1>
      <p>Kies een plek. Kies een vriend.</p>
    </div>
    <button class="help" id="helpBtn" type="button">Hulp nodig?</button>
  </header>

  <nav class="rooms" aria-label="Plek in de hub" id="rooms"></nav>

  <div>
    <div class="table" id="table" aria-label="Aan tafel"></div>
  </div>

  <main class="chat" id="chat" aria-live="polite"></main>

  <div>
    <div class="tools"><button class="link" id="aboutBtn" type="button">Hoe werkt dit?</button><button class="link" id="resetBtn" type="button">Gesprek wissen</button></div>
    <form class="composer" id="form">
      <textarea id="input" rows="1" placeholder="Typ iets…" aria-label="Bericht"></textarea>
      <button class="send" id="sendBtn" type="submit">Stuur</button>
    </form>
  </div>
</div>

<dialog id="about"><div class="dlg">
  <h2>Vriendschap</h2>
  <p>iDruzen is een plek om te praten. Mo ontvangt je en stelt je voor aan iemand die bij je past.</p>
  <ul>
    <li>Geen erotiek, geen flirten.</li>
    <li>Wel: kletsen, steun, humor, goede vragen.</li>
    <li>Bij crisis verwijzen we je door naar echte hulp.</li>
    <li>De vrienden zijn AI. Ze zijn geen hulpverleners.</li>
    <li>Voor 18+. Je gesprekken blijven in je eigen browser; berichten gaan alleen even naar de AI om een antwoord te maken en worden door ons niet opgeslagen.</li>
  </ul>
  <button class="chip primary" type="button" onclick="this.closest('dialog').close()">Sluiten</button>
</div></dialog>

<script>
/* Vul hier de link van je Supabase Edge Function in */
const API_URL = "https://ecajbqpxckxrygjhnhkf.supabase.co/functions/v1/chat-mo";

const ROOMS = [
  {id:"cafe", name:"Café", hint:"luchtig, dagpraat"},
  {id:"bib", name:"Bib", hint:"rustig en dieper"},
  {id:"film", name:"Filmhoek", hint:"films en verhalen"}
];
const PEOPLE = {
  mo:{name:"Mo", role:"host", color:"#1F3A93"},
  truus:{name:"Truus", role:"warm en nuchter", color:"#B5562E"},
  niels:{name:"Niels", role:"Amsterdam, droog en lief", color:"#2F6B5A"},
  sam:{name:"Sam", role:"zacht en gestructureerd", color:"#6E5A9E"},
  noor:{name:"Noor", role:"films, boeken, kunst", color:"#8A5A2B"},
  elias:{name:"Elias", role:"denker, op uitnodiging", color:"#3A4A5E"}
};
const MO_WELCOME = `Hé, welkom. Mo hier, ik ben je host.
We hebben drie hoekjes: het Café voor dagpraat en grapjes, de Bib voor rust en diepere dingen, en de Filmhoek voor verhalen.
Zal ik eerst iets inschenken?`;
const CRISIS_RE = /(zelfmoord|suïcid|suicid|mezelf (iets )?(aan|aandoen|pijn)|niet meer (willen )?leven|wil dood|dood willen|er een eind aan|ophangen|overdosis|mezelf snijden|zelfbeschadig)/i;

const KEY="idruzen_state_v1";
const fresh=()=>({room:"cafe", active:"mo", seated:["mo"], logs:{mo:[]}});
let state=load()||fresh(), busy=false;
function load(){ try{ return JSON.parse(localStorage.getItem(KEY)); }catch(e){ return null; } }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }

const $=s=>document.querySelector(s);
const chat=$("#chat"), input=$("#input");
function logFor(id){ return state.logs[id]||(state.logs[id]=[]); }
function scroll(){ chat.scrollTop=chat.scrollHeight; }
function roomName(){ return ROOMS.find(r=>r.id===state.room).name; }

function renderRooms(){
  const nav=$("#rooms"); nav.innerHTML="";
  ROOMS.forEach(r=>{
    const b=document.createElement("button"); b.type="button"; b.className="room";
    b.setAttribute("aria-pressed", String(state.room===r.id));
    b.innerHTML="<b></b><span></span>"; b.querySelector("b").textContent=r.name; b.querySelector("span").textContent=r.hint;
    b.onclick=()=>{ if(state.room===r.id) return; state.room=r.id; save(); renderRooms(); note(`Je schuift aan in de ${r.name}.`); };
    nav.appendChild(b);
  });
}
function renderTable(){
  const t=$("#table"); t.innerHTML="";
  state.seated.forEach(id=>{
    const p=PEOPLE[id]; const b=document.createElement("button"); b.type="button"; b.className="seat";
    b.setAttribute("aria-current", String(state.active===id));
    b.innerHTML='<span class="face"></span><span><strong></strong><small></small></span>';
    b.querySelector(".face").style.background=p.color; b.querySelector(".face").textContent=p.name[0];
    b.querySelector("strong").textContent=p.name; b.querySelector("small").textContent=p.role;
    b.onclick=()=>switchTo(id); t.appendChild(b);
  });
}
function renderChat(){
  chat.innerHTML="";
  const log=logFor(state.active);
  log.forEach(m=>{
    if(m.role==="note"){ if(m.text) note(m.text,false); return; }
    bubble(m.role==="user"?"me":"them", m.text, m.role==="user"?null:PEOPLE[state.active].name);
  });
  if(log.length===0 && state.active==="mo") moWelcome();
  scroll();
}
function bubble(side,text,who){
  if(who){ const w=document.createElement("div"); w.className="who"; w.textContent=who; chat.appendChild(w); }
  const d=document.createElement("div"); d.className="msg "+side; d.textContent=text; chat.appendChild(d); scroll(); return d;
}
function note(text,persist=true){
  const d=document.createElement("div"); d.className="note"; d.textContent=text; chat.appendChild(d); scroll();
  if(persist){ logFor(state.active).push({role:"note",text}); save(); }
}
function choices(list){
  const box=document.createElement("div"); box.className="choice";
  list.forEach(([label,fn,primary])=>{
    const b=document.createElement("button"); b.type="button"; b.className="chip"+(primary?" primary":"");
    b.textContent=label; b.onclick=()=>{ box.remove(); fn(); }; box.appendChild(b);
  });
  chat.appendChild(box); scroll();
}
function crisisCard(){
  const c=document.createElement("div"); c.className="crisis"; c.setAttribute("role","region"); c.setAttribute("aria-label","Hulp");
  c.innerHTML=`<p><strong>Je veiligheid gaat voor.</strong> De vrienden hier zijn AI en geen hulpdienst. Praat met een mens:</p>
  <div class="calls"><a href="tel:112">Bel 112, direct gevaar</a><a href="tel:113">Bel 113, zelfmoordpreventie</a><a href="tel:08000113">Bel 0800-0113, gratis</a></div>
  <p style="margin:10px 0 0;font-size:14px">Chatten kan ook via <a href="https://www.113.nl" target="_blank" rel="noopener" style="background:none;color:inherit;padding:0;text-decoration:underline">113.nl</a>. Politie zonder spoed: <a href="tel:09008844" style="background:none;color:inherit;padding:0;text-decoration:underline">0900-8844</a>.</p>`;
  chat.appendChild(c); scroll();
}

function moWelcome(){
  bubble("them", MO_WELCOME, "Mo");
  logFor("mo").push({role:"assistant", text:MO_WELCOME}); save();
  choices([["☕ Koffie",()=>send("Koffie graag ☕")],["🍵 Thee",()=>send("Thee graag 🍵")],
           ["🍷 Wijntje",()=>send("Doe maar een wijntje 🍷")],["Nee, dank je",()=>send("Nee dank je, ik wil gewoon even praten")]]);
}
function switchTo(id){
  if(state.active===id) return;
  state.active=id; if(!state.seated.includes(id)) state.seated.push(id);
  save(); renderTable(); renderChat();
  if(logFor(id).length===0) greet(id);
}
function recap(from){
  return logFor(from).filter(m=>m.role!=="note").slice(-8)
    .map(m=>(m.role==="user"?"Gebruiker: ":PEOPLE[from].name+": ")+m.text).join("\n");
}
function introduce(id){
  const p=PEOPLE[id]; if(!p) return;
  choices([[`Ja, stel me voor aan ${p.name}`,()=>{ state.introFrom="mo"; note(`Mo neemt je mee naar ${p.name}.`); switchTo(id); },true],
           ["Ik blijf nog even bij Mo",()=>{}]]);
}
function inviteElias(){
  choices([["Ja, haal Elias erbij",()=>{ state.introFrom=state.active; note("Elias schuift even aan."); switchTo("elias"); },true],
           ["Nee",()=>{}],["Misschien later",()=>{}]]);
}

async function callApi(payload){
  const r=await fetch(API_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
  if(!r.ok) throw new Error("status "+r.status);
  return r.json();
}
function historyFor(id){
  return logFor(id).filter(m=>m.role!=="note").slice(-16).map(m=>({role:m.role,content:m.text}));
}
async function greet(id){ await talk(id,{character:id, room:state.room, mode:"greet", context:recap(state.introFrom||"mo"), history:[]}); }
async function send(text){
  text=(text||"").trim(); if(!text||busy) return;
  document.querySelectorAll(".choice").forEach(e=>e.remove());
  const id=state.active;
  bubble("me",text,null); logFor(id).push({role:"user",text}); save();
  if(CRISIS_RE.test(text)) crisisCard();
  await talk(id,{character:id, room:state.room, mode:"chat", history:historyFor(id)});
}
async function talk(id,payload){
  busy=true; $("#sendBtn").disabled=true;
  const p=PEOPLE[id];
  const w=document.createElement("div"); w.className="who"; w.textContent=p.name; chat.appendChild(w);
  const d=document.createElement("div"); d.className="msg them"; d.textContent="…"; chat.appendChild(d); scroll();
  try{
    const res=await callApi(payload);
    d.textContent=res.reply; logFor(id).push({role:"assistant",text:res.reply}); save();
    if(res.crisis) crisisCard();
    if(res.introduce && id==="mo") introduce(res.introduce);
    if(res.askElias) inviteElias();
    if(id==="elias" && logFor("elias").filter(m=>m.role==="user").length>=4 && !logFor("elias").some(m=>m.back)){
      logFor("elias").push({role:"note",text:"",back:true}); save();
      const prev=state.seated.find(s=>s!=="mo"&&s!=="elias")||"mo";
      choices([[`Terug naar ${PEOPLE[prev].name}`,()=>switchTo(prev)],["Nog even met Elias",()=>{}]]);
    }
  }catch(e){
    d.textContent="Dat ging mis, de verbinding hapert. Stuur je bericht nog eens.";
  }
  busy=false; $("#sendBtn").disabled=false;
}

$("#form").addEventListener("submit",e=>{ e.preventDefault(); const t=input.value; input.value=""; autosize(); send(t); });
input.addEventListener("keydown",e=>{ if(e.key==="Enter"&&!e.shiftKey){ e.preventDefault(); $("#form").requestSubmit(); }});
input.addEventListener("input",autosize);
function autosize(){ input.style.height="auto"; input.style.height=Math.min(input.scrollHeight,140)+"px"; }
$("#helpBtn").onclick=crisisCard;
$("#aboutBtn").onclick=()=>$("#about").showModal();
$("#resetBtn").onclick=()=>{ if(!confirm("Alle gesprekken wissen?")) return; state=fresh(); save(); renderRooms(); renderTable(); renderChat(); };
renderRooms(); renderTable(); renderChat();
</script>
</body>
</html>
